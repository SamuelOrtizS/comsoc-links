---
import type { LinkItem } from '../utils/loadLinks';
import DynamicIcon from './DynamicIcon.astro';
import { Icon } from 'astro-icon/components';

interface Props {
  link: LinkItem;
}

const { link } = Astro.props;
---

<a
  href={link.url}
  target="_blank"
  rel="noopener noreferrer"
  class={`group relative flex items-center justify-between p-4 rounded-2xl w-full text-left cursor-pointer transition-all duration-300 ${
    link.destacado ? 'featured-card' : 'glass-card'
  }`}
  aria-label={link.titulo}
>
  <div class="flex items-center gap-4 min-w-0 pr-3">
    <!-- Icon Container -->
    <div
      class={`flex-shrink-0 w-12 h-12 rounded-xl flex items-center justify-center transition-all duration-300 ${
        link.destacado
          ? 'bg-ieee-comsoc-cyan/20 text-ieee-comsoc-cyan border border-ieee-comsoc-cyan/40 group-hover:scale-105'
          : 'bg-white/5 text-gray-200 border border-white/10 group-hover:bg-ieee-blue/20 group-hover:border-ieee-comsoc-cyan/30 group-hover:text-ieee-comsoc-cyan'
      }`}
    >
      <DynamicIcon icon={link.icono} class="w-6 h-6" alt={link.titulo} />
    </div>

    <!-- Title and Description -->
    <div class="flex flex-col min-w-0">
      <div class="flex items-center gap-2">
        <span class="font-formata text-base font-semibold text-white group-hover:text-ieee-comsoc-cyan transition-colors duration-200 truncate">
          {link.titulo}
        </span>
        {link.destacado && (
          <span class="px-2 py-0.5 text-[10px] uppercase font-bold tracking-wider rounded-full bg-ieee-comsoc-cyan/20 text-ieee-comsoc-cyan border border-ieee-comsoc-cyan/30">
            Destacado
          </span>
        )}
      </div>

      {link.descripcion && (
        <span class="text-xs text-text-secondary mt-0.5 line-clamp-1 group-hover:text-gray-300 transition-colors">
          {link.descripcion}
        </span>
      )}
    </div>
  </div>

  <!-- External link indicator -->
  <div class="flex-shrink-0 text-gray-400 group-hover:text-ieee-comsoc-cyan group-hover:translate-x-1 transition-all duration-200">
    <Icon name="material-symbols:arrow-outward-rounded" class="w-5 h-5" />
  </div>
</a>
